{
    "name": "wedevs/wp-kit",
    "description": "WordPress toolkit: DataLayer, Migration, Admin Notifications",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "WeDevs\\WPKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeDevs\\WPKit\\Tests\\": "tests/phpunit/tests/"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit"
    }
}
